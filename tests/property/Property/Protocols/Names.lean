/-- A fork version from a number: its four bytes, the most significant first. -/
def versionOf (value : Nat) : Version :=
  #v[UInt8.ofNat (value >>> 24), UInt8.ofNat (value >>> 16), UInt8.ofNat (value >>> 8),
    UInt8.ofNat value]

/-- A configuration with one value replaced, by the name of the value in consensus-specs.

A fork version is given as the number that its four bytes spell.

A name that the configuration does not have, or whose value is no number, leaves it as it was. -/
def setConfig (config : Config) (name : String) (value : Nat) : Config :=
  let v := UInt64.ofNat value
  match name with
  | "TERMINAL_BLOCK_HASH_ACTIVATION_EPOCH" =>
    { config with TERMINAL_BLOCK_HASH_ACTIVATION_EPOCH := v }
  | "MIN_GENESIS_ACTIVE_VALIDATOR_COUNT" => { config with MIN_GENESIS_ACTIVE_VALIDATOR_COUNT := v }
  | "MIN_GENESIS_TIME" => { config with MIN_GENESIS_TIME := v }
  | "GENESIS_FORK_VERSION" => { config with GENESIS_FORK_VERSION := versionOf value }
  | "GENESIS_DELAY" => { config with GENESIS_DELAY := v }
  | "ALTAIR_FORK_VERSION" => { config with ALTAIR_FORK_VERSION := versionOf value }
  | "ALTAIR_FORK_EPOCH" => { config with ALTAIR_FORK_EPOCH := v }
  | "BELLATRIX_FORK_VERSION" => { config with BELLATRIX_FORK_VERSION := versionOf value }
  | "BELLATRIX_FORK_EPOCH" => { config with BELLATRIX_FORK_EPOCH := v }
  | "CAPELLA_FORK_VERSION" => { config with CAPELLA_FORK_VERSION := versionOf value }
